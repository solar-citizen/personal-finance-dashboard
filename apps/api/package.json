{
  "name": "api",
  "private": true,
  "license": "GPL-3.0-only",
  "postinstall": "prisma generate",
  "type": "module",
  "scripts": {
    "dev": "bun start:dev",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,bin,prisma}/**/*.ts\"",
    "lint:fix": "eslint \"{src,bin,prisma}/**/*.ts\" --fix",
    "db:push": "prisma db push && bun run prisma/scripts/create-vector-index.script.ts",
    "db:generate": "prisma generate",
    "db:seed": "bun run prisma/seed.ts",
    "db:backfill-rates": "bun run prisma/backfill-exchange-rates.ts",
    "db:reset": "prisma db push && prisma generate && bun db:seed",
    "db:force-reset": "prisma db push --force-reset && prisma generate && bun db:seed",
    "db:studio": "prisma studio",
    "openapi:generate": "bun run build && bun run ./dist/apps/api/bin/generate-openapi.script.js",
    "dtos:generate": "bun run bin/generate-dtos.script.ts",
    "codegen": "bun run db:generate && bun run dtos:generate && bun run openapi:generate",
    "mcc": "bun run prisma/scripts/analyze-mcc.script.ts",
    "generate-key": "bun run bin/generate-key.script.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pfd/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "chrono-node": "^2.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "helmet": "^8.2.0",
    "nestjs-zod": "^5.4.0",
    "ollama": "^0.6.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@openapi-codegen/cli": "^3.1.0",
    "@openapi-codegen/typescript": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/passport-jwt": "^4.0.1",
    "globals": "^17.7.0",
    "prisma": "7.8.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
