generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ISO 4217 literal code
enum Currency {
  uah
  usd
  eur
}

enum AccountType {
  black
  white
  platinum
  iron
  fop
  yellow
  eAid
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
}

enum MessageRole {
  system
  user
  assistant
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String?
  
  messages  Message[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, createdAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role           MessageRole
  content        String   // The actual message text
  
  // Store context that was used for this message
  contextUsed    Json?    // { transactionCount: 5, categories: [...], dateRange: {...} }
  
  // Store embedding for semantic search of chat history
  embedding      Unsupported("vector(768)")?
  
  // Performance metrics
  tokensUsed     Int?
  responseTimeMs Int?
  
  createdAt      DateTime @default(now())
  
  @@index([conversationId, createdAt])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  
  accounts      Account[]
  conversations Conversation[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SyncJob {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status        SyncJobStatus
  progress      Int      @default(0)
  total         Int      @default(0)
  from          DateTime
  to            DateTime
  newCount      Int      @default(0)
  updatedCount  Int      @default(0)
  errorMessage  String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // MonoBank specific
  accountId String
  iban      String?
  type      AccountType
  currency  Currency
  balance   BigInt   // in minimal units (kopiykas)
  creditLimit BigInt @default(0)
  
  // Sync metadata
  monoToken    String?
  lastSyncedAt DateTime?
  webHookUrl   String?

  syncJobs  SyncJob[]
  
  transactions Transaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, accountId])
  @@index([userId])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  mcc   Int    @unique // Merchant Category Code
  icon  String
  color String
  
  transactions Transaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Transaction {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  // MonoBank data
  externalId  String   // transaction ID
  time        DateTime // transaction time
  description String
  
  mcc         Int
  originalMcc Int?
  hold        Boolean  @default(false)
  
  amount            BigInt // in minimal units (kopiykas)
  operationAmount   BigInt
  currencyCode      Int    // ISO 4217 numeric code
  
  commissionRate    BigInt @default(0)
  cashbackAmount    BigInt @default(0)
  balance           BigInt // balance after transaction
  
  comment           String?
  receiptId         String?
  invoiceId         String?
  
  counterEdrpou     String?
  counterIban       String?
  counterName       String?
  
  // Our categorization
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@unique([accountId, externalId])
  @@index([accountId, time])
  @@index([categoryId])
}

model KnowledgeBase {
  id        String                 @id @default(cuid())
  content   String
  metadata  Json?
  embedding Unsupported("vector(768)") // nomic-embed-text dimension
  
  createdAt DateTime @default(now())
  
  @@index([embedding], name: "knowledge_base_embedding_idx")
}
