{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "dependsOn": ["^openapi:generate"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "openapi:generate": {
      "outputs": ["openapi.json"],
      "cache": false
    },
    "gen:api": {
      "dependsOn": ["^openapi:generate"],
      "cache": false
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
