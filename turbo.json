{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["codegen"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "codegen": {
      "cache": false
    },
    "dtos:generate": {
      "cache": false
    },
    "openapi:generate": {
      "outputs": ["_generated/openapi.json"],
      "cache": false
    },
    "gen:api": {
      "dependsOn": ["^openapi:generate"],
      "cache": false
    }
  }
}
